<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主页：书签列表 -->
    <ScrollView
        android:id="@+id/home_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_close_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:text="✕"
                    android:textColor="#666666"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="书签"
                    android:textColor="#222222"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_add_site"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:text="＋ 添加"
                    android:textColor="#4A6DA7"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="还没有书签\n点击右上角「＋ 添加」收藏你的第一个站点"
                android:textColor="#999999"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/site_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- 浏览视图：顶部地址栏 + WebView + 底部工具栏 -->
    <LinearLayout
        android:id="@+id/browser_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#F2F2F2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="▣ 1"
                android:textColor="#333333"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/address_bar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_address_bar"
                android:ellipsize="start"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="#555555"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_reload"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="↻"
                android:textColor="#333333"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btn_star"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="12dp"
                android:text="☆"
                android:textColor="#333333"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 极细加载进度条 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="#4A6DA7"
            android:progressBackgroundTint="#00000000"
            android:visibility="gone" />

        <!-- WebView 容器：TabManager 动态挂载各标签的 WebView；浮动全屏按钮叠于其上 -->
        <FrameLayout
            android:id="@+id/web_slot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_fullscreen"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_fab"
                android:contentDescription="全屏"
                android:scaleType="fitCenter"
                android:padding="5dp"
                android:src="@drawable/ic_expand"
                app:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottom_toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#F2F2F2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_nav_back"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="‹"
                android:textColor="#333333"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btn_nav_forward"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="›"
                android:textColor="#333333"
                android:textSize="22sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="⌂"
                android:textColor="#333333"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 标签概览层（覆盖在浏览视图之上） -->
    <LinearLayout
        android:id="@+id/tab_switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE222222"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/tab_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

        <TextView
            android:id="@+id/btn_new_tab"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="＋ 新建标签"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="#33000000" />
    </LinearLayout>
</FrameLayout>
